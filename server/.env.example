# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/hirescope

# Port this Node API listens on
PORT=5000

# Which browser origin(s) may call this API. Comma-separated, no trailing slash.
# In production this is your deployed client URL, e.g.
#   CLIENT_ORIGIN=https://hirescope.vercel.app,https://hirescope-git-main-you.vercel.app
# Anything not listed gets a 403. Requests with no Origin header (curl, health
# checks) are always allowed - those are not browser cross-origin requests.
CLIENT_ORIGIN=http://localhost:3000

# Base URL of the Python ML microservice (ml-service/app.py)
ML_SERVICE_URL=http://localhost:5001

# Google Gemini API key - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Adzuna job search - powers the "Browse real openings" panel.
# Free registration at https://developer.adzuna.com/
# Leave these blank and the panel hides itself; pasting a job description by
# hand keeps working either way.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna namespaces results by country. "in" is India.
ADZUNA_COUNTRY=in
